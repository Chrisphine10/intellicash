  decidedAt       DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product   ExternalLoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meeting   Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  requester User?               @relation("ExternalLoanRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([productId, status])
}

/**
 * A member's payment into the group made through a payment gateway —
 * M-Pesa STK push (Daraja) or Paystack checkout. "Classic" M-Pesa, where a
 * member pays manually and reads out the confirmation code, never creates
 * one of these: it is recorded straight onto the ledger entry instead.
 */
model GroupPayment {
  id                    String    @id @default(cuid())
  groupId               String
  memberId              String?
  meetingId             String?
  /// SHARE_PURCHASE | SOCIAL_FUND | LOAN_REPAYMENT | FINE | OTHER
  purpose               String    @default("SHARE_PURCHASE")
  /// MPESA_DARAJA | PAYSTACK
  provider              String
  amountCents           Int
  currency              String    @default("KES")
  phoneNumber           String?
  customerEmail         String?
  /// PENDING | COMPLETED | FAILED | CANCELLED
  status                String    @default("PENDING")
  internalReference     String    @unique
  providerReference     String?
  providerTransactionId String?
  checkoutUrl           String?
  failureReason         String?
  metadataJson          String?
  /// Lets the phone retry a request without charging twice.
  clientRequestId       String?   @unique
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member  Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([providerReference])
}

/**
 * A vote the group runs: electing an official (ROLE_ELECTION) or deciding a
 * motion (DECISION). Members cast one vote each; closing the poll freezes
 * the tally and writes the outcome into the group's minute book.
 */
model Poll {
  id              String    @id @default(cuid())
  groupId         String
  meetingId       String?
  /// ROLE_ELECTION | DECISION
  type            String    @default("DECISION")
  title           String
  description     String?
  /// The office being filled, when type is ROLE_ELECTION.
  targetRole      String?
  /// OPEN | CLOSED
  status          String    @default("OPEN")
  /// A secret ballot hides who voted for what; the tally is still public.
  secretBallot    Boolean   @default(false)
  createdByUserId String?
  closesAt        DateTime?
  closedAt        DateTime?
  resultSummary   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group   Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meeting Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  options PollOption[]
  votes   PollVote[]

  @@index([groupId, status])
}

model PollOption {
  id       String  @id @default(cuid())
  pollId   String
  label    String
  /// The candidate, when this option is a member standing for office.
  memberId String?
  position Int     @default(0)

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  memberId String
  castAt   DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// One member, one vote.
  @@unique([pollId, memberId])
  @@index([optionId])
}

/**
 * Someone with a member account asking to be added to a group.
 * A group's code is printed on its materials, so it is NOT a secret and
 * cannot be the only gate: the request grants NOTHING until an official
 * approves it. Until then the requester's account stays unlinked and sees
 * none of the group's money.
 * On approval the group is matched to an existing Member row by phone
 * (groups usually enter their members during setup, before those people
 * install the app); only if there is no match is a new Member created.
 */
model GroupJoinRequest {
  id              String    @id @default(cuid())
  groupId         String
  /// The account asking to join.
  userId          String
  requestedName   String
  phone           String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status          String    @default("PENDING")
  /// Member row this was matched or linked to once approved.
  memberId        String?
  reviewNotes     String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One live request per person per group.
  @@unique([groupId, userId])
  @@index([groupId, status])
}

/**
 * One person's place in one group. The source of truth for "which groups am
 * I in" -- people commonly belong to several VSLAs at once, so a single
 * pointer on User could never express it.
 * User.memberId still holds whichever of these is currently in view, and all
 * permission scoping resolves against that. Switching groups repoints it.
 */
model UserMembership {
  id        String   @id @default(cuid())
  userId    String
  /// A Member row is one person in one group, so it links to exactly one account.
  memberId  String   @unique
  groupId   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
}
