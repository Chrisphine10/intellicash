}

/**
 * A group's application for an external loan product. `creditBand` freezes
 * the group's rating at application time; `meetingId` links the application
 * to the meeting it was raised in, when applied mid-meeting.
 */
model ExternalLoanApplication {
  id              String    @id @default(cuid())
  productId       String
  groupId         String
  meetingId       String?
  requesterUserId String?
  amountCents     Int
  purpose         String
  creditBand      String?
  status          String    @default("PENDING")
