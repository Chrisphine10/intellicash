generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?  @unique
  passwordHash       String
  role               String
  status             String   @default("ACTIVE")
  avatarUrl          String?
  languagePreference String   @default("ENGLISH")
  partnerId          String?
  groupId            String?
  /**
   * The membership currently in view. A person can belong to several groups
   * (see UserMembership); this is the one all scoping resolves against, so
   * switching groups means repointing this. Null for group/agent logins.
   */
  memberId           String?  @unique
  /**
   * Binding for a VILLAGE_AGENT login: the agent this account acts as.
   */
  villageAgentId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  partner                  Partner?                  @relation(fields: [partnerId], references: [id])
  group                    Group?                    @relation(fields: [groupId], references: [id])
  member                   Member?                   @relation(fields: [memberId], references: [id])
  villageAgent             VillageAgent?             @relation(fields: [villageAgentId], references: [id])
  sessions                 Session[]
  apiKeys                  ApiKey[]
  notifications            Notification[]
  auditEvents              AuditEvent[]
  capturedMeetingKeys      MeetingKeySubmission[]    @relation("MeetingKeyCapturedBy")
  storeCreditRequests      StoreCreditRequest[]      @relation("StoreCreditRequester")
  offlineDevices           OfflineDevice[]
  externalLoanApplications ExternalLoanApplication[] @relation("ExternalLoanRequester")
  groupJoinRequests        GroupJoinRequest[]
  memberships              UserMembership[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String    @default("INFO")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  scopesJson String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RolePermissionTemplate {
  id              String   @id @default(cuid())
  role            String   @unique
  permissionsJson String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id               String   @id @default(cuid())
  name             String
  type             String
  status           String   @default("ACTIVE")
  apiScope         String   @default("PROGRAMME")
  county           String?
  contactName      String?
  contactPhone     String?
  valueProposition String?
  capacity         String?
  linkageType      String?
  sourceSystem     String?
  sourceReference  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                       User[]
  wallet                      PartnerWallet?
  signupRequests              PartnerSignupRequest[]
  programmes                  Programme[]
  programmeLinks              ProgrammePartner[]
  walletTransactions          PartnerWalletTransaction[]
  webhookSubscriptions        WebhookSubscription[]
  storeFinancedCreditRequests StoreCreditRequest[]       @relation("StoreCreditFinancier")
  externalLoanProducts        ExternalLoanProduct[]
}

model Programme {
  id               String    @id @default(cuid())
  partnerId        String
  name             String
  country          String    @default("Kenya")
  county           String?
  description      String?
  coverImageUrl    String?
  sourceSystem     String?
  sourceReference  String?
  publicSlug       String?   @unique
  publicStatus     String    @default("DRAFT")
  fundingGoalCents Int       @default(0)
  fundingSummary   String?
  impactSummary    String?
  fundingDeadline  DateTime?
  allowInvestments Boolean   @default(true)
  allowDonations   Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  partner              Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerLinks         ProgrammePartner[]
  groupLinks           ProgrammeGroup[]
  groups               Group[]
  villageAgents        VillageAgent[]
  walletTransactions   PartnerWalletTransaction[]
  assets               ProgrammeAsset[]
  storeProductLinks    StoreProductProgramme[]
  storeCreditRequests  StoreCreditRequest[]
  agentBookingRequests AgentBookingRequest[]
}

model ProgrammeAsset {
  id          String   @id @default(cuid())
  programmeId String
  type        String
  visibility  String   @default("PRIVATE")
  title       String
  description String?
  url         String
  fileName    String?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}

model PartnerSignupRequest {
  id                         String    @id @default(cuid())
  organizationName           String
  organizationType           String
  requestedRole              String    @default("PARTNER_OFFICER")
  requestedPartnerType       String    @default("NGO")
  contactName                String
  contactEmail               String
  contactPhone               String?
  county                     String?
  groupSubCounty             String?
  groupLocation              String?
  groupMeetingDay            String?
  groupObjective             String?
  estimatedMembers           Int?
  championRole               String?
  assignedVillageAgentId     String?
  fieldVisitStatus           String    @default("NOT_REQUIRED")
  fieldVisitNotes            String?
  fieldVisitScheduledAt      DateTime?
  fieldVisitedAt             DateTime?
  fieldVisitReviewedByUserId String?
  valueProposition           String?
  status                     String    @default("PENDING")
  reviewNotes                String?
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  createdPartnerId           String?
  createdGroupId             String?
  createdMemberId            String?
  createdUserId              String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  createdPartner       Partner?      @relation(fields: [createdPartnerId], references: [id], onDelete: SetNull)
  assignedVillageAgent VillageAgent? @relation("SignupFieldAgent", fields: [assignedVillageAgentId], references: [id], onDelete: SetNull)
}

model PartnerWallet {
  id           String   @id @default(cuid())
  partnerId    String   @unique
  balanceCents Int      @default(0)
  heldCents    Int      @default(0)
  currency     String   @default("KES")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner      Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions PartnerWalletTransaction[]
}

model PartnerWalletTransaction {
  id                    String    @id @default(cuid())
  walletId              String?
  partnerId             String?
  programmeId           String?
  actorUserId           String?
  approvedByUserId      String?
  type                  String
  provider              String
  source                String    @default("WALLET")
  status                String    @default("PENDING")
  amountCents           Int
  currency              String    @default("KES")
  description           String?
  customerName          String?
  customerEmail         String?
  phoneNumber           String?
  payoutPhoneNumber     String?
  payoutRecipientCode   String?
  providerReference     String?   @unique
  internalReference     String    @unique
  providerCheckoutUrl   String?
  providerAccessCode    String?
  providerTransactionId String?
  providerMetadataJson  String?
  failureReason         String?
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  wallet    PartnerWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  partner   Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  programme Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  eventId        String?  @unique
  reference      String?
  signatureValid Boolean  @default(false)
  payloadJson    String
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ProgrammePartner {
  id          String   @id @default(cuid())
  programmeId String
  partnerId   String
  role        String   @default("PARTNER")
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([programmeId, partnerId, role])
}

model ProgrammeGroup {
  id          String   @id @default(cuid())
  programmeId String
  groupId     String
  role        String   @default("PRIMARY")
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([programmeId, groupId])
}

model VillageAgent {
  id                   String   @id @default(cuid())
  programmeId          String?
  name                 String
  phone                String
  email                String?
  gender               String?
  projectOfficer       String?
  county               String?
  location             String?
  feedback             String?
  sourceSystem         String?
  sourceReference      String?
  status               String   @default("ACTIVE")
  digitalLiteracyScore Int      @default(80)
  caseloadLimit        Int      @default(25)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  programme                Programme?                   @relation(fields: [programmeId], references: [id])
  groups                   Group[]
  /**
   * Login accounts that act as this agent (VILLAGE_AGENT role).
   */
  userAccounts             User[]
  bookingRequests          AgentBookingRequest[]
  signupRequests           PartnerSignupRequest[]       @relation("SignupFieldAgent")
  storeCreditDistributions StoreCreditRequest[]         @relation("StoreCreditDistributor")
  storeProductProgrammes   StoreProductProgrammeAgent[]
}

model StoreSupplier {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("ACTIVE")
  contactName  String?
  contactPhone String?
  contactEmail String?
  county       String?
  location     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products StoreProduct[]
}

model StoreProduct {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  category          String
  status            String   @default("ACTIVE")
  supplierId        String?
  description       String
  imageUrl          String?
  sellerName        String?
  priceCents        Int
  depositCents      Int      @default(0)
  currency          String   @default("KES")
  creditSummary     String?
  fulfilmentSummary String?
  inventoryCount    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier       StoreSupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  programmeLinks StoreProductProgramme[]
  creditRequests StoreCreditRequest[]
}

model StoreProductProgramme {
  id                   String   @id @default(cuid())
  productId            String
  programmeId          String
  creditTerms          String?
  depositRateBps       Int      @default(1000)
  installmentCount     Int      @default(6)
  installmentFrequency String   @default("MONTHLY")
  flatInterestRateBps  Int      @default(0)
  gracePeriodDays      Int      @default(30)
  createdAt            DateTime @default(now())

  product       StoreProduct                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  programme     Programme                    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  defaultAgents StoreProductProgrammeAgent[]

  @@unique([productId, programmeId])
}

model StoreProductProgrammeAgent {
  id                 String   @id @default(cuid())
  productProgrammeId String
  villageAgentId     String
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  productProgramme StoreProductProgramme @relation(fields: [productProgrammeId], references: [id], onDelete: Cascade)
  villageAgent     VillageAgent          @relation(fields: [villageAgentId], references: [id], onDelete: Cascade)

  @@unique([productProgrammeId, villageAgentId])
}

model StoreCreditRequest {
  id                   String    @id @default(cuid())
  productId            String
  programmeId          String
  requesterUserId      String?
  distributionAgentId  String?
  financierPartnerId   String?
  customerName         String
  customerEmail        String
  phoneNumber          String
  county               String?
  groupName            String?
  /**
   * The buying group, when the purchase is made by a VSLA group. Drives
   * credit-rating-based pricing.
   */
  groupId              String?
  /**
   * The meeting where the group agreed this purchase, when it was bought in
   * one. Lets the minute book account for money committed during a sitting,
   * the same way external loan applications do.
   */
  meetingId            String?
  /**
   * The group's credit band at the moment of purchase. Frozen here so the
   * agreed price is never rewritten by a later score change.
   */
  creditBand           String?
  quantity             Int       @default(1)
  requestedAmountCents Int
  depositCents         Int       @default(0)
  financedAmountCents  Int       @default(0)
  commissionRateBps    Int       @default(500)
  commissionCents      Int       @default(0)
  repaymentStatus      String    @default("NOT_FINANCED")
  status               String    @default("PENDING")
  notes                String?
  reviewNotes          String?
  financedAt           DateTime?
  fulfilledAt          DateTime?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  product           StoreProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  programme         Programme                @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  group             Group?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  meeting           Meeting?                 @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  requester         User?                    @relation("StoreCreditRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  distributionAgent VillageAgent?            @relation("StoreCreditDistributor", fields: [distributionAgentId], references: [id], onDelete: SetNull)
  financierPartner  Partner?                 @relation("StoreCreditFinancier", fields: [financierPartnerId], references: [id], onDelete: SetNull)
  installments      StoreCreditInstallment[]
  repayments        StoreCreditRepayment[]
}

model StoreCreditInstallment {
  id             String    @id @default(cuid())
  requestId      String
  sequence       Int
  dueDate        DateTime
  principalCents Int
  interestCents  Int
  totalDueCents  Int
  paidCents      Int       @default(0)
  status         String    @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request    StoreCreditRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  repayments StoreCreditRepayment[]

  @@unique([requestId, sequence])
  @@index([dueDate, status])
}

model StoreCreditRepayment {
  id                String   @id @default(cuid())
  requestId         String
  installmentId     String?
  amountCents       Int
  source            String   @default("MANUAL")
  provider          String?
  providerReference String?
  recordedByUserId  String?
  notes             String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  request     StoreCreditRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  installment StoreCreditInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
}

model AgentBookingRequest {
  id             String    @id @default(cuid())
  villageAgentId String?
  programmeId    String?
  serviceType    String
  preferredDate  DateTime?
  customerName   String
  customerEmail  String
  phoneNumber    String
  county         String?
  groupName      String?
  notes          String?
  status         String    @default("PENDING")
  reviewNotes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  villageAgent VillageAgent? @relation(fields: [villageAgentId], references: [id], onDelete: SetNull)
  programme    Programme?    @relation(fields: [programmeId], references: [id], onDelete: SetNull)
}

model Group {
  id                           String   @id @default(cuid())
  programmeId                  String?
  villageAgentId               String?
  name                         String
  code                         String   @unique
  phase                        String
  county                       String
  subCounty                    String?
  location                     String?
  composition                  String?
  objective                    String?
  contactPersonName            String?
  contactPhone                 String?
  onboardingFeedback           String?
  sourceSystem                 String?
  sourceReference              String?
  meetingDay                   String?
  gpsLatitude                  Float?
  gpsLongitude                 Float?
  gpsRadiusMeters              Int      @default(50)
  shareValueCents              Int      @default(50000)
  maxSharesPerMemberPerMeeting Int      @default(10)
  constitutionVersion          String   @default("IWLSGS-1.0")
  cycleNumber                  Int      @default(1)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  programme                Programme?                @relation(fields: [programmeId], references: [id])
  programmeLinks           ProgrammeGroup[]
  villageAgent             VillageAgent?             @relation(fields: [villageAgentId], references: [id])
  userAccounts             User[]
  members                  Member[]
  meetings                 Meeting[]
  fundAccounts             FundAccount[]
  ledgerEntries            LedgerEntry[]
  votes                    Vote[]
  creditScores             CreditScore[]
  offlineDevices           OfflineDevice[]
  storeCreditRequests      StoreCreditRequest[]
  externalLoanApplications ExternalLoanApplication[]
  groupPayments            GroupPayment[]
  integrationConfigs       GroupIntegrationConfig[]
  polls                    Poll[]
  joinRequests             GroupJoinRequest[]
  memberships              UserMembership[]
}

model Member {
  id                  String    @id @default(cuid())
  groupId             String
  fullName            String
  nationalIdHash      String?
  phone               String
  role                String    @default("MEMBER")
  kycStatus           String    @default("PENDING")
  status              String    @default("ACTIVE")
  pinHash             String?
  pinSetAt            DateTime?
  pinUpdatedAt        DateTime?
  currentOtpHash      String?
  currentOtpIssuedAt  DateTime?
  currentOtpExpiresAt DateTime?
  joinedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  group           Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userAccounts    User[]
  membershipLinks UserMembership[]
  attendance      Attendance[]
  ledgerEntries   LedgerEntry[]
  keySubmissions  MeetingKeySubmission[]
  pinDeliveries   MemberPinDelivery[]
  groupPayments   GroupPayment[]
  pollCandidacies PollOption[]
  pollVotes       PollVote[]
}

model Meeting {
  id               String    @id @default(cuid())
  groupId          String
  title            String
  status           String
  scheduledAt      DateTime
  openedAt         DateTime?
  closedAt         DateTime?
  unlockStatus     String    @default("PENDING")
  gpsCompliant     Boolean   @default(false)
  transactionTotal Int       @default(0)
  minutes          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group                    Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  steps                    MeetingStepRecord[]
  attendance               Attendance[]
  keySubmissions           MeetingKeySubmission[]
  ledgerEntries            LedgerEntry[]
  votes                    Vote[]
  externalLoanApplications ExternalLoanApplication[]
  storeCreditRequests      StoreCreditRequest[]
  groupPayments            GroupPayment[]
  polls                    Poll[]
}

model MeetingKeySubmission {
  id                String    @id @default(cuid())
  meetingId         String
  memberId          String
  capturedByUserId  String?
  deviceId          String?
  capturedOfflineAt DateTime?
  credentialType    String    @default("DEFAULT_PIN")
  verifiedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  meeting        Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member         Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  capturedByUser User?   @relation("MeetingKeyCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@unique([meetingId, memberId])
}

model MemberPinDelivery {
  id                String    @id @default(cuid())
  memberId          String
  requestedByUserId String?
  provider          String    @default("AFRICAS_TALKING")
  channel           String    @default("SMS")
  purpose           String    @default("DEFAULT_PIN")
  phone             String
  status            String    @default("QUEUED")
  messagePreview    String
  messageCiphertext String
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([status, createdAt])
}

model SmsBroadcast {
  id                String   @id @default(cuid())
  requestedByUserId String?
  targetType        String
  targetGroupId     String?
  targetMemberId    String?
  provider          String
  message           String
  status            String   @default("QUEUED")
  recipientCount    Int      @default(0)
  queuedCount       Int      @default(0)
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipients SmsBroadcastRecipient[]

  @@index([createdAt])
  @@index([targetType, createdAt])
  @@index([targetGroupId, createdAt])
  @@index([targetMemberId, createdAt])
}

model SmsBroadcastRecipient {
  id                String    @id @default(cuid())
  broadcastId       String
  memberId          String?
  groupId           String?
  memberName        String
  phone             String
  provider          String
  status            String    @default("QUEUED")
  providerReference String?
  providerStatus    String?
  providerMessage   String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  broadcast SmsBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([memberId, createdAt])
  @@index([groupId, createdAt])
  @@index([status, createdAt])
}

model MeetingStepRecord {
  id          String    @id @default(cuid())
  meetingId   String
  step        String
  name        String
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, step])
}

model Attendance {
  id         String   @id @default(cuid())
  meetingId  String
  memberId   String
  status     String
  recordedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
}

model FundAccount {
  id           String   @id @default(cuid())
  groupId      String
  type         String
  balanceCents Int      @default(0)
  currency     String   @default("KES")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([groupId, type])
}

model LedgerEntry {
  id                String   @id @default(cuid())
  groupId           String
  memberId          String?
  meetingId         String?
  fundAccountId     String?
  type              String
  amountCents       Int
  currency          String   @default("KES")
  direction         String
  description       String
  signature         String
  externalReference String?
  clientRequestId   String?  @unique
  createdAt         DateTime @default(now())

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  meeting     Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  fundAccount FundAccount? @relation(fields: [fundAccountId], references: [id], onDelete: SetNull)
}

model OfflineDevice {
  id             String    @id @default(cuid())
  groupId        String
  userId         String?
  deviceId       String
  status         String    @default("ACTIVE")
  cacheExpiresAt DateTime
  lastPreparedAt DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([groupId, deviceId])
  @@index([status, cacheExpiresAt])
}

model Vote {
  id             String   @id @default(cuid())
  groupId        String
  meetingId      String?
  resolutionType String
  motion         String
  result         String
  quorumRequired Int
  yesCount       Int
  noCount        Int
  abstainCount   Int
  totalEligible  Int
  hash           String
  createdAt      DateTime @default(now())

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

model CreditScore {
  id            String   @id @default(cuid())
  groupId       String
