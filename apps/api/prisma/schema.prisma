}

model LedgerEntry {
  id                String   @id @default(cuid())
  groupId           String
  /// Nullable for backward compatibility; backfilled to the group's cycle.
  cycleId           String?
  /// Which loan a LOAN_REPAYMENT belongs to. Nullable: historical repayments
  /// that cannot be attributed unambiguously still count toward the member's
  /// outstanding total, so backfill never loses money it cannot place.
  loanId            String?
  memberId          String?
  meetingId         String?
  fundAccountId     String?
  type              String
  amountCents       Int
  currency          String   @default("KES")
  direction         String
  description       String
  signature         String
  externalReference String?
  clientRequestId   String?  @unique
  createdAt         DateTime @default(now())

  group          Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  cycle          Cycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  loan           Loan?           @relation("LoanRepayments", fields: [loanId], references: [id], onDelete: SetNull)
  welfareExpense WelfareExpense?
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  meeting        Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  fundAccount    FundAccount?    @relation(fields: [fundAccountId], references: [id], onDelete: SetNull)

  // The ledger is the fastest-growing table in the system and is read by
  // group, by member and by meeting. Ordered by createdAt for statements.
  @@index([groupId, createdAt])
  @@index([memberId, createdAt])
  @@index([meetingId])
}

