/// Per-group payment provider credentials.
///
/// A group that has its own M-Pesa till or Paystack account keeps it here, so
/// members' money settles into THEIR account rather than the platform's.
/// Resolution order is group config -> platform IntegrationConfig -> process
/// env, so a group without a row simply uses the platform default.
///
/// credentialsJson is AES-256-GCM encrypted with the same key as
/// IntegrationConfig (derived from SESSION_SECRET). Rotating SESSION_SECRET
/// makes every stored credential undecryptable - re-enter them if you do.
model GroupIntegrationConfig {
  id                   String    @id @default(cuid())
  groupId              String
  /// "MPESA_DARAJA" | "PAYSTACK". MPESA_CLASSIC needs no credentials: the
  /// member types the transaction code in by hand.
  provider             String
  credentialsJson      String?
  enabled              Boolean   @default(true)
  mode                 String    @default("SANDBOX")
  credentialsUpdatedAt DateTime?
  /// Who last changed it - money routing must be attributable.
  updatedByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, provider])
  @@index([groupId])
}

model IntegrationConfig {
  id                   String    @id @default(cuid())
  provider             String    @unique
  displayName          String
  mode                 String    @default("SANDBOX")
  enabled              Boolean   @default(true)
  requiredEnvJson      String
  credentialsJson      String?
  credentialsUpdatedAt DateTime?
  callbackUrl          String?
  lastCheckedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

