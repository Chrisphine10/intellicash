generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?  @unique
  passwordHash       String
  role               String
  status             String   @default("ACTIVE")
  avatarUrl          String?
  languagePreference String   @default("ENGLISH")
  partnerId          String?
  groupId            String?
  /**
   * The membership currently in view. A person can belong to several groups
   * (see UserMembership); this is the one all scoping resolves against, so
   * switching groups means repointing this. Null for group/agent logins.
   */
  memberId           String?  @unique
  /**
   * Binding for a VILLAGE_AGENT login: the agent this account acts as.
   */
  villageAgentId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  partner                  Partner?                  @relation(fields: [partnerId], references: [id])
  group                    Group?                    @relation(fields: [groupId], references: [id])
  member                   Member?                   @relation(fields: [memberId], references: [id])
  villageAgent             VillageAgent?             @relation(fields: [villageAgentId], references: [id])
  sessions                 Session[]
  apiKeys                  ApiKey[]
  notifications            Notification[]
  auditEvents              AuditEvent[]
  capturedMeetingKeys      MeetingKeySubmission[]    @relation("MeetingKeyCapturedBy")
  storeCreditRequests      StoreCreditRequest[]      @relation("StoreCreditRequester")
  offlineDevices           OfflineDevice[]
  externalLoanApplications ExternalLoanApplication[] @relation("ExternalLoanRequester")
  groupJoinRequests        GroupJoinRequest[]
  memberships              UserMembership[]
  visitsSubmitted          GroupVisit[]              @relation("GroupVisitSubmitter")
  visitsAmended            GroupVisitRevision[]      @relation("GroupVisitAmender")
  templatesPublished       AssessmentTemplate[]      @relation("AssessmentTemplatePublisher")
  attachmentsUploaded      Attachment[]              @relation("AttachmentUploader")
  documentsVerified        GroupDocument[]           @relation("GroupDocumentVerifier")
  templatesCreated         AssessmentTemplate[]      @relation("AssessmentTemplateCreator")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String    @default("INFO")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  scopesJson String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RolePermissionTemplate {
  id              String   @id @default(cuid())
  role            String   @unique
  permissionsJson String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id               String   @id @default(cuid())
  name             String
  type             String
  status           String   @default("ACTIVE")
  /// Sample data, kept off every public surface and out of every total.
  ///
  /// `Programme.isDemo` alone was not enough: a demo group, its partner and its
  /// agent each reach the outside world by their own route — the landing page
  /// lists partners, the public store lists agents, and the portfolio and
  /// foundation reports count groups, members and savings. Demo figures mixed
  /// into a partner's impact numbers are worse than demo data on a marketing
  /// page, because nobody can see they are wrong.
  ///
  /// Signed-in demo accounts still see their own demo data. That is the point
  /// of having it.
  isDemo           Boolean  @default(false)
  apiScope         String   @default("PROGRAMME")
  county           String?
  contactName      String?
  contactPhone     String?
  valueProposition String?
  capacity         String?
  linkageType      String?
  sourceSystem     String?
  sourceReference  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                       User[]
  wallet                      PartnerWallet?
  signupRequests              PartnerSignupRequest[]
  programmes                  Programme[]
  villageAgents               VillageAgent[]
  programmeLinks              ProgrammePartner[]
  walletTransactions          PartnerWalletTransaction[]
  webhookSubscriptions        WebhookSubscription[]
  storeFinancedCreditRequests StoreCreditRequest[]       @relation("StoreCreditFinancier")
  externalLoanProducts        ExternalLoanProduct[]
}

model Programme {
  id              String  @id @default(cuid())
  partnerId       String
  name            String
  country         String  @default("Kenya")
  county          String?
  description     String?
  coverImageUrl   String?
  sourceSystem    String?
  sourceReference String?
  publicSlug      String? @unique
  publicStatus    String  @default("DRAFT")

  /// Sample data, kept out of every PUBLIC surface.
  ///
  /// The seeded partner and programme exist so the platform is explorable, and
  /// `publicStatus: "ONGOING"` was the only thing the public endpoints filtered
  /// on — so the demo project and its partner were listed on the landing page
  /// to anyone who visited. Everything public hangs off a programme (its
  /// partner, village agents, store products, the groups shown under an agent),
  /// so one flag here removes all of them together.
  ///
  /// Signed-in surfaces are deliberately unaffected: a demo account still sees
  /// demo data, which is the point of having it.
  isDemo           Boolean   @default(false)
  fundingGoalCents Int       @default(0)
  fundingSummary   String?
  impactSummary    String?
  fundingDeadline  DateTime?
  allowInvestments Boolean   @default(true)
  allowDonations   Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  partner              Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerLinks         ProgrammePartner[]
  groupLinks           ProgrammeGroup[]
  groups               Group[]
  villageAgentLinks    VillageAgentProgramme[]
  walletTransactions   PartnerWalletTransaction[]
  assets               ProgrammeAsset[]
  storeProductLinks    StoreProductProgramme[]
  storeCreditRequests  StoreCreditRequest[]
  agentBookingRequests AgentBookingRequest[]
}

model ProgrammeAsset {
  id          String   @id @default(cuid())
  programmeId String
  type        String
  visibility  String   @default("PRIVATE")
  title       String
  description String?
  url         String
  fileName    String?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}

model PartnerSignupRequest {
  id                         String    @id @default(cuid())
  organizationName           String
  organizationType           String
  requestedRole              String    @default("PARTNER_OFFICER")
  requestedPartnerType       String    @default("NGO")
  contactName                String
  contactEmail               String
  contactPhone               String?
  county                     String?
  groupSubCounty             String?
  groupLocation              String?
  groupMeetingDay            String?
  groupObjective             String?
  estimatedMembers           Int?
  championRole               String?
  assignedVillageAgentId     String?
  fieldVisitStatus           String    @default("NOT_REQUIRED")
  fieldVisitNotes            String?
  fieldVisitScheduledAt      DateTime?
  fieldVisitedAt             DateTime?
  fieldVisitReviewedByUserId String?
  valueProposition           String?
  status                     String    @default("PENDING")
  reviewNotes                String?
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  createdPartnerId           String?
  createdGroupId             String?
  createdMemberId            String?
  createdUserId              String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  createdPartner       Partner?      @relation(fields: [createdPartnerId], references: [id], onDelete: SetNull)
  assignedVillageAgent VillageAgent? @relation("SignupFieldAgent", fields: [assignedVillageAgentId], references: [id], onDelete: SetNull)
}

model PartnerWallet {
  id           String   @id @default(cuid())
  partnerId    String   @unique
  balanceCents Int      @default(0)
  heldCents    Int      @default(0)
  currency     String   @default("KES")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner      Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions PartnerWalletTransaction[]
}

model PartnerWalletTransaction {
  id                    String    @id @default(cuid())
  walletId              String?
  partnerId             String?
  programmeId           String?
  actorUserId           String?
  approvedByUserId      String?
  type                  String
  provider              String
  source                String    @default("WALLET")
  status                String    @default("PENDING")
  amountCents           Int
  currency              String    @default("KES")
  description           String?
  customerName          String?
  customerEmail         String?
  phoneNumber           String?
  payoutPhoneNumber     String?
  payoutRecipientCode   String?
  providerReference     String?   @unique
  internalReference     String    @unique
  providerCheckoutUrl   String?
  providerAccessCode    String?
  providerTransactionId String?
  providerMetadataJson  String?
  failureReason         String?
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  wallet    PartnerWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  partner   Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  programme Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  eventId        String?  @unique
  reference      String?
  signatureValid Boolean  @default(false)
  payloadJson    String
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ProgrammePartner {
  id          String   @id @default(cuid())
  programmeId String
  partnerId   String
  role        String   @default("PARTNER")
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([programmeId, partnerId, role])
}

model ProgrammeGroup {
  id          String   @id @default(cuid())
  programmeId String
  groupId     String
  role        String   @default("PRIMARY")
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([programmeId, groupId])
}

model VillageAgent {
  id String @id @default(cuid())

  /**
   * The one partner this agent works for.
   * An agent is engaged by a partner and then assigned to that partner's
   * programmes — which is why the partner sits here and the programmes sit in
   * `programmeLinks`. It is what makes "the same partner" a rule the service
   * can check rather than a convention people remember.
   * Nullable: an agent can exist before being attached to a programme, and
   * agents that pre-date this column have it backfilled from whichever
   * programme they were on.
   */
  partnerId String?

  name            String
  phone           String
  email           String?
  gender          String?
  projectOfficer  String?
  county          String?
  location        String?
  feedback        String?
  sourceSystem    String?
  sourceReference String?
  status          String  @default("ACTIVE")

  /// Sample data, kept off every public surface and out of every total.
  ///
  /// `Programme.isDemo` alone was not enough: a demo group, its partner and its
  /// agent each reach the outside world by their own route — the landing page
  /// lists partners, the public store lists agents, and the portfolio and
  /// foundation reports count groups, members and savings. Demo figures mixed
  /// into a partner's impact numbers are worse than demo data on a marketing
  /// page, because nobody can see they are wrong.
  ///
  /// Signed-in demo accounts still see their own demo data. That is the point
  /// of having it.
  isDemo               Boolean  @default(false)
  digitalLiteracyScore Int      @default(80)
  caseloadLimit        Int      @default(25)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  partner                  Partner?                     @relation(fields: [partnerId], references: [id])
  /**
   * Every programme this agent serves. Replaces the single `programmeId` that
   * used to live on this model: an agent commonly works across several of a
   * partner's programmes, and the old shape forced somebody to pick one and
   * lose the rest.
   */
  programmeLinks           VillageAgentProgramme[]
  groups                   Group[]
  /**
   * Login accounts that act as this agent (VILLAGE_AGENT role).
   */
  userAccounts             User[]
  bookingRequests          AgentBookingRequest[]
  visits                   GroupVisit[]
  attachments              Attachment[]
  signupRequests           PartnerSignupRequest[]       @relation("SignupFieldAgent")
  storeCreditDistributions StoreCreditRequest[]         @relation("StoreCreditDistributor")
  storeProductProgrammes   StoreProductProgrammeAgent[]
}

/**
 * Which programmes a village agent serves.
 * Every programme here must belong to the agent's `partnerId`. That is enforced
 * in `village-agent-service.ts` rather than by the database: SQLite can express
 * it only through composite foreign keys that would make every read of this
 * table more awkward than the rule is worth, and the check has one entry point.
 */
model VillageAgentProgramme {
  id             String   @id @default(cuid())
  villageAgentId String
  programmeId    String
  createdAt      DateTime @default(now())

  villageAgent VillageAgent @relation(fields: [villageAgentId], references: [id], onDelete: Cascade)
  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([villageAgentId, programmeId])
  @@index([programmeId])
}

model StoreSupplier {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("ACTIVE")
  contactName  String?
  contactPhone String?
  contactEmail String?
  county       String?
  location     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products StoreProduct[]
}

model StoreProduct {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  category          String
  status            String   @default("ACTIVE")
  supplierId        String?
  description       String
  imageUrl          String?
  sellerName        String?
  priceCents        Int
  depositCents      Int      @default(0)
  currency          String   @default("KES")
  creditSummary     String?
  fulfilmentSummary String?
  inventoryCount    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier       StoreSupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  programmeLinks StoreProductProgramme[]
  creditRequests StoreCreditRequest[]
}

model StoreProductProgramme {
  id                   String   @id @default(cuid())
  productId            String
  programmeId          String
  creditTerms          String?
  depositRateBps       Int      @default(1000)
  installmentCount     Int      @default(6)
  installmentFrequency String   @default("MONTHLY")
  flatInterestRateBps  Int      @default(0)
  gracePeriodDays      Int      @default(30)
  createdAt            DateTime @default(now())

  product       StoreProduct                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  programme     Programme                    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  defaultAgents StoreProductProgrammeAgent[]

  @@unique([productId, programmeId])
}

model StoreProductProgrammeAgent {
  id                 String   @id @default(cuid())
  productProgrammeId String
  villageAgentId     String
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  productProgramme StoreProductProgramme @relation(fields: [productProgrammeId], references: [id], onDelete: Cascade)
  villageAgent     VillageAgent          @relation(fields: [villageAgentId], references: [id], onDelete: Cascade)

  @@unique([productProgrammeId, villageAgentId])
}

model StoreCreditRequest {
  id                   String    @id @default(cuid())
  productId            String
  programmeId          String
  requesterUserId      String?
  distributionAgentId  String?
  financierPartnerId   String?
  customerName         String
  customerEmail        String
  phoneNumber          String
  county               String?
  groupName            String?
  /**
   * The buying group, when the purchase is made by a VSLA group. Drives
   * credit-rating-based pricing.
   */
  groupId              String?
  /**
   * The meeting where the group agreed this purchase, when it was bought in
   * one. Lets the minute book account for money committed during a sitting,
   * the same way external loan applications do.
   */
  meetingId            String?
  /**
   * The group's credit band at the moment of purchase. Frozen here so the
   * agreed price is never rewritten by a later score change.
   */
  creditBand           String?
  quantity             Int       @default(1)
  requestedAmountCents Int
  depositCents         Int       @default(0)
  financedAmountCents  Int       @default(0)
  commissionRateBps    Int       @default(500)
  commissionCents      Int       @default(0)
  repaymentStatus      String    @default("NOT_FINANCED")
  status               String    @default("PENDING")
  notes                String?
  reviewNotes          String?
  financedAt           DateTime?
  fulfilledAt          DateTime?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  product           StoreProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  programme         Programme                @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  group             Group?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  meeting           Meeting?                 @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  requester         User?                    @relation("StoreCreditRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  distributionAgent VillageAgent?            @relation("StoreCreditDistributor", fields: [distributionAgentId], references: [id], onDelete: SetNull)
  financierPartner  Partner?                 @relation("StoreCreditFinancier", fields: [financierPartnerId], references: [id], onDelete: SetNull)
  installments      StoreCreditInstallment[]
  repayments        StoreCreditRepayment[]
}

model StoreCreditInstallment {
  id             String    @id @default(cuid())
  requestId      String
  sequence       Int
  dueDate        DateTime
  principalCents Int
  interestCents  Int
  totalDueCents  Int
  paidCents      Int       @default(0)
  status         String    @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request    StoreCreditRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  repayments StoreCreditRepayment[]

  @@unique([requestId, sequence])
  @@index([dueDate, status])
}

model StoreCreditRepayment {
  id                String   @id @default(cuid())
  requestId         String
  installmentId     String?
  amountCents       Int
  source            String   @default("MANUAL")
  provider          String?
  providerReference String?
  recordedByUserId  String?
  notes             String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  request     StoreCreditRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  installment StoreCreditInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
}

model AgentBookingRequest {
  id             String    @id @default(cuid())
  villageAgentId String?
  programmeId    String?
  serviceType    String
  preferredDate  DateTime?
  customerName   String
  customerEmail  String
  phoneNumber    String
  county         String?
  groupName      String?
  notes          String?
  status         String    @default("PENDING")
  reviewNotes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  villageAgent VillageAgent? @relation(fields: [villageAgentId], references: [id], onDelete: SetNull)
  programme    Programme?    @relation(fields: [programmeId], references: [id], onDelete: SetNull)
}

model Group {
  id             String  @id @default(cuid())
  programmeId    String?
  villageAgentId String?
  name           String
  code           String  @unique

  /// Sample data, kept out of every total.
  ///
  /// A demo group counted into the portfolio and foundation reports puts made-up
  /// savings, members and credit scores next to real ones, where nobody can tell
  /// them apart. Signed-in demo accounts still see their own group; it simply
  /// stops being evidence about anything.
  isDemo                       Boolean  @default(false)
  phase                        String
  county                       String
  subCounty                    String?
  location                     String?
  composition                  String?
  objective                    String?
  contactPersonName            String?
  contactPhone                 String?
  onboardingFeedback           String?
  sourceSystem                 String?
  sourceReference              String?
  meetingDay                   String?
  gpsLatitude                  Float?
  gpsLongitude                 Float?
  gpsRadiusMeters              Int      @default(50)
  shareValueCents              Int      @default(50000)
  maxSharesPerMemberPerMeeting Int      @default(10)
  constitutionVersion          String   @default("IWLSGS-1.0")
  cycleNumber                  Int      @default(1)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  programme                Programme?                @relation(fields: [programmeId], references: [id])
  programmeLinks           ProgrammeGroup[]
  villageAgent             VillageAgent?             @relation(fields: [villageAgentId], references: [id])
  userAccounts             User[]
  members                  Member[]
  meetings                 Meeting[]
  fundAccounts             FundAccount[]
  ledgerEntries            LedgerEntry[]
  votes                    Vote[]
  creditScores             CreditScore[]
  offlineDevices           OfflineDevice[]
  storeCreditRequests      StoreCreditRequest[]
  externalLoanApplications ExternalLoanApplication[]
  groupPayments            GroupPayment[]
  integrationConfigs       GroupIntegrationConfig[]
  polls                    Poll[]
  joinRequests             GroupJoinRequest[]
  memberships              UserMembership[]
  cycles                   Cycle[]
  loans                    Loan[]
  welfareExpenses          WelfareExpense[]
  groupPolicies            GroupPolicy[]
  memberRoleAssignments    MemberRoleAssignment[]
  visits                   GroupVisit[]
  attachments              Attachment[]
  documents                GroupDocument[]
  actionItems              VisitActionItem[]
  enterprises              GroupEnterprise[]
}

/// One field visit: one agent, one group, one occasion.
///
/// A SUBMITTED visit is immutable. There is no PATCH — an amendment writes a
/// GroupVisitRevision holding the previous state and bumps `revision`, so the
/// record of what was reported at the time survives the correction.
model GroupVisit {
  id                String  @id @default(cuid())
  groupId           String
  /// The agent row, not the login. An agent may hold several logins over time
  /// and the visit belongs to the person, not the credential.
  villageAgentId    String?
  /// The login that submitted it, for the audit trail.
  submittedByUserId String?

  /// Minted on the phone when the opening PIN passes, and never regenerated —
  /// not on retry, resume, or reinstall. This is the whole idempotency story:
  /// a repeat POST returns the existing visit rather than creating a second.
  clientRequestId String @unique

  visitType String @default("FOLLOW_UP")
  status    String @default("SUBMITTED")

  /// When the agent opened the visit on the device, which is not when the
  /// server received it — often days apart in the field.
  startedAt   DateTime
  completedAt DateTime?
  submittedAt DateTime  @default(now())

  /// Device reading. Nullable: a phone that never got a fix must still be able
  /// to file the visit.
  deviceLatitude     Float?
  deviceLongitude    Float?
  /// Metres of uncertainty reported by the device.
  locationAccuracyM  Float?
  locationCapturedAt DateTime?

  /// Server-computed distance to the group's registered point, and the verdict
  /// derived from it. Never trusted from the client — the deliberate contrast
  /// with Meeting.gpsCompliant, a client-asserted boolean nobody validates.
  distanceFromGroupM Float?
  locationOutcome    String  @default("NO_DEVICE_FIX")
  withinGeofence     Boolean @default(false)

  /// The agent's explanation when the location does not match — "group met at
  /// the chief's camp". An explanation channel, not evidence.
  locationNote String?

  /// Non-fatal observations worth surfacing to a reviewer: PIN retries, a fix
  /// far outside the geofence, a device clock well adrift. JSON array.
  authenticityFlagsJson String @default("[]")

  deviceId String?
  notes    String?

  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  villageAgent VillageAgent?            @relation(fields: [villageAgentId], references: [id])
  submittedBy  User?                    @relation("GroupVisitSubmitter", fields: [submittedByUserId], references: [id])
  revisions    GroupVisitRevision[]
  assessment   GroupVisitAssessment?
  attachments  Attachment[]
  mentorship   VisitMentorshipSession[]
  ratings      VisitMentorshipRating[]
  actionItems  VisitActionItem[]        @relation("ActionItemRaisedAt")

  @@index([groupId, startedAt])
  @@index([villageAgentId, startedAt])
}

/// The state of a visit before an amendment. Append-only.
model GroupVisitRevision {
  id              String   @id @default(cuid())
  visitId         String
  /// The revision number this snapshot holds — i.e. the value before the bump.
  revision        Int
  /// Full serialized visit as it stood, so a reviewer can read what was
  /// originally reported without reconstructing it from field-level diffs.
  snapshotJson    String
  reason          String?
  amendedByUserId String?
  createdAt       DateTime @default(now())

  visit     GroupVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  amendedBy User?      @relation("GroupVisitAmender", fields: [amendedByUserId], references: [id])

  @@unique([visitId, revision])
}

/// One version of a scorecard.
///
/// A DRAFT is editable. Publishing validates it, freezes a snapshot, and makes
/// the row immutable — editing a published template means cloning it to a new
/// DRAFT at `version + 1`. That is what lets a two-year-old assessment still be
/// defended: the rules that scored it cannot be edited out from under it.
///
/// `familyKey` is stable across versions — it is what says v1 and v4 are the
/// same instrument, and what cross-version trends join on.
model AssessmentTemplate {
  id          String  @id @default(cuid())
  familyKey   String
  version     Int
  status      String  @default("DRAFT")
  title       String
  description String?

  /// Sum of the question weights. Null until published, because until then it
  /// is still moving — and it is computed, never typed in. There is no 92 here.
  maxPoints Float?

  /// The band definitions, as authored. JSON rather than a table: they are
  /// meaningless apart from the template, always read as a set, and never
  /// queried across templates.
  bandsJson String @default("[]")

  publishedAt       DateTime?
  publishedByUserId String?
  createdByUserId   String?
  /// Set when this template was cloned from another, so the lineage is legible.
  clonedFromId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections    AssessmentSection[]
  snapshot    AssessmentTemplateSnapshot?
  assessments GroupVisitAssessment[]
  publishedBy User?                       @relation("AssessmentTemplatePublisher", fields: [publishedByUserId], references: [id])
  createdBy   User?                       @relation("AssessmentTemplateCreator", fields: [createdByUserId], references: [id])
  clonedFrom  AssessmentTemplate?         @relation("AssessmentTemplateLineage", fields: [clonedFromId], references: [id])
  clones      AssessmentTemplate[]        @relation("AssessmentTemplateLineage")

  @@unique([familyKey, version])
  @@index([status])
}

model AssessmentSection {
  id          String  @id @default(cuid())
  templateId  String
  /// Stable across versions. Section-level trends join on this, so renaming a
  /// section is free but re-keying one breaks the history.
  key         String
  title       String
  description String?
  position    Int

  template  AssessmentTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]

  @@unique([templateId, key])
}

model AssessmentQuestion {
  id           String  @id @default(cuid())
  sectionId    String
  key          String
  prompt       String
  guidance     String?
  /// Points at full credit. Yes/Partial/No earn all/half/none of it.
  weight       Float
  position     Int
  requiresNote Boolean @default(false)

  section AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// Only section-scoped here — SQLite cannot express uniqueness across the
  /// whole template through a join. Template-wide uniqueness is enforced by
  /// `validateAssessmentTemplate` at publish, which is also where a duplicate
  /// would first do damage.
  @@unique([sectionId, key])
}

/// The frozen, self-contained form of a published template.
///
/// Everything needed to render and score, with no foreign keys to walk — so a
/// historical assessment reads its snapshot and never touches the live rows.
model AssessmentTemplateSnapshot {
  id         String @id @default(cuid())
  templateId String @unique
  version    Int

  /// The full AssessmentTemplateSnapshot document from the contract.
  snapshotJson           String
  /// sha256 over the canonical form. The phone sends the checksum of the
  /// snapshot it rendered; a mismatch means it scored against a stale copy and
  /// the server's re-score is authoritative.
  checksum               String
  maxPoints              Float
  scoringContractVersion String

  createdAt DateTime @default(now())

  template    AssessmentTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assessments GroupVisitAssessment[]

  @@index([checksum])
}

/// One completed assessment, belonging to exactly one visit.
///
/// Every scoring input is stored alongside the result — snapshot, template
/// version, contract version and the full breakdown — so the number can be
/// re-derived and explained without re-reading anything that may have changed.
model GroupVisitAssessment {
  id      String @id @default(cuid())
  visitId String @unique

  templateSnapshotId     String
  templateId             String
  templateVersion        Int
  scoringContractVersion String

  earnedPoints     Float
  applicablePoints Float
  maxPoints        Float
  /// Earned points rescaled onto the full range, which is what was banded.
  scaledPoints     Float
  percentage       Float
  bandKey          String?
  bandLabel        String?

  /// False when questions were left unanswered — a partial assessment is
  /// recorded rather than refused, but it is never silently treated as whole.
  complete Boolean @default(false)

  /// The full AssessmentScore, so the section-by-section explanation survives
  /// without re-running the contract.
  breakdownJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit    GroupVisit                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  snapshot AssessmentTemplateSnapshot @relation(fields: [templateSnapshotId], references: [id])
  template AssessmentTemplate         @relation(fields: [templateId], references: [id])
  answers  GroupVisitAnswer[]

  @@index([templateId, createdAt])
}

model GroupVisitAnswer {
  id           String  @id @default(cuid())
  assessmentId String
  /// Denormalized from the snapshot so a per-question or per-section query does
  /// not have to parse JSON, and so the answer stays readable if the question
  /// is dropped in a later template version.
  sectionKey   String
  questionKey  String
  choice       String
  note         String?

  assessment GroupVisitAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// The idempotency guard for answers: a retried visit payload re-upserts the
  /// same rows rather than forking a second set.
  @@unique([assessmentId, questionKey])
  @@index([questionKey])
}

/// A photograph or document, always bound to what it is evidence OF.
///
/// One table serves both a visit photo and a standing group document, so the
/// linkage columns are nullable. That is a storage fact, not a licence: the
/// "never an anonymous gallery" rule is enforced per kind in Zod at the route,
/// where VISIT_PHOTO requires visit, section, agent and capture time. Encoding
/// it in column nullability instead would mean either a second table or
/// columns that lie about GROUP_DOCUMENT.
model Attachment {
  id      String @id @default(cuid())
  kind    String
  groupId String

  /// Set for evidence captured during a visit; null for a standing document.
  visitId     String?
  /// Which question the photograph answers. The reason capture is offered only
  /// from a question rather than a global "add photo" button — a picture with
  /// no claim attached to it is not evidence of anything.
  sectionKey  String?
  questionKey String?

  villageAgentId   String?
  uploadedByUserId String?

  /// Relative to the upload root, e.g. `visit-photo/2026/08/<uuid>.jpg`.
  /// Never an absolute path: the storage location is allowed to move.
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int
  /// Content hash. What makes a retried upload safe.
  sha256      String

  /// When the photograph was TAKEN on the device, which is not when it was
  /// received — often days apart in the field.
  capturedAt DateTime?

  caption String?

  /// Minted on the phone and never regenerated, so a retry re-binds the same
  /// attachment rather than creating a second.
  clientRequestId String? @unique

  createdAt DateTime @default(now())

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  visit        GroupVisit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  villageAgent VillageAgent? @relation(fields: [villageAgentId], references: [id])
  uploadedBy   User?         @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id])

  /// The same image cannot be attached to one visit twice. Scoped to the visit
  /// rather than global: two groups may legitimately photograph the same blank
  /// form, and a hash collision across unrelated visits is not a duplicate.
  @@unique([sha256, visitId])
  @@index([groupId, createdAt])
  @@index([visitId])
}

/// A document a group is expected to hold — registration certificate, bank
/// mandate, constitution.
///
/// `presence` and `verification` are deliberately separate columns rather than
/// one four-state enum. Verified / Not verified / Missing / Expired conflates
/// three different things: whether the document exists, a back-office judgement
/// about it, and a fact derived from a date. Merged, the question "how many
/// verified certificates expire this quarter" cannot be asked at all — an
/// expired one has overwritten the fact that it was ever verified.
///
/// EXPIRED is therefore never stored. It is derived from `expiresOn`, which
/// means it cannot go stale and no nightly job is needed to keep it honest.
model GroupDocument {
  id      String @id @default(cuid())
  groupId String

  documentType String
  /// PRESENT | MISSING — does the group have it at all?
  presence     String @default("MISSING")
  /// UNVERIFIED | VERIFIED | REJECTED — a human judgement about the copy held.
  verification String @default("UNVERIFIED")

  /// Null when the document does not expire.
  expiresOn DateTime?

  attachmentId String?
  notes        String?

  verifiedByUserId String?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("GroupDocumentVerifier", fields: [verifiedByUserId], references: [id])

  @@unique([groupId, documentType])
}

/// A subject a field agent can coach a group on. Configurable reference data.
model MentorshipTopic {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions VisitMentorshipSession[]
}

/// Coaching delivered during one visit, on one topic.
///
/// `topicKeySnapshot` and `topicTitleSnapshot` are copied in at write time so
/// the record still reads if the topic is later renamed or retired. A session
/// that says "we coached them on <deleted>" is worthless as history, and
/// forbidding deletion instead would leave a settings screen nobody can tidy.
model VisitMentorshipSession {
  id      String @id @default(cuid())
  visitId String

  topicId            String?
  topicKeySnapshot   String
  topicTitleSnapshot String

  /// What was actually discussed and advised.
  notes           String?
  /// Minutes spent, when the agent records it.
  durationMinutes Int?

  createdAt DateTime @default(now())

  visit GroupVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  topic MentorshipTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([visitId, topicKeySnapshot])
  @@index([topicKeySnapshot])
}

/// An axis the group scores the coaching on — clarity, usefulness, respect.
model MentorshipRatingDimension {
  id       String  @id @default(cuid())
  key      String  @unique
  title    String
  position Int     @default(0)
  isActive Boolean @default(true)

  ratings VisitMentorshipRating[]
}

/// The group's 1-5 score for the mentorship it received.
///
/// Given by the group's REPRESENTATIVE, not the agent. An agent rating their
/// own session scores 4 or 5 every time and the aggregate says nothing; the
/// representative is already holding the phone for the sign-off PIN, so asking
/// them costs nothing. `ratedByRole` records who actually answered, so an
/// aggregate can exclude anything not given by the group.
model VisitMentorshipRating {
  id      String @id @default(cuid())
  visitId String

  dimensionId          String?
  dimensionKeySnapshot String
  score                Int

  /// GROUP_REPRESENTATIVE | AGENT. Stored rather than assumed.
  ratedByRole String  @default("GROUP_REPRESENTATIVE")
  comment     String?

  createdAt DateTime @default(now())

  visit     GroupVisit                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  dimension MentorshipRatingDimension? @relation(fields: [dimensionId], references: [id], onDelete: SetNull)

  @@unique([visitId, dimensionKeySnapshot])
}

/// Something the group agreed to do before the next visit.
///
/// Deliberately separate from IntelliAuditRecommendation, which carries the
/// same owner/dueDate/status shape but is bound to audit findings and an
/// approval flow that does not apply here.
///
/// There is NO stored OVERDUE column. Lateness is derived from `dueDate` at
/// read time — see `domain/action-plan.ts` — so it is right the moment it is
/// asked and needs no nightly job.
model VisitActionItem {
  id      String @id @default(cuid())
  visitId String
  groupId String

  title   String
  detail  String?
  /// Free text: "the treasurer", "the chairlady". Not a member FK, because the
  /// owner is often a role rather than a person on the register.
  owner   String?
  dueDate DateTime?
  status  String    @default("OPEN")

  /// The visit at which it was closed, when it was.
  closedAtVisitId String?
  closedAt        DateTime?
  closingNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit GroupVisit @relation("ActionItemRaisedAt", fields: [visitId], references: [id], onDelete: Cascade)
  group Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([status, dueDate])
}

/// A collective enterprise the group runs.
///
/// A group may run several — a poultry unit and a cereal store are different
/// businesses with different margins, buyers and support needs, and averaging
/// them produces a figure describing neither. This used to be one row per group
/// (`GroupBusinessProfile`, `groupId @unique`), which forced whoever was
/// capturing a second enterprise to overwrite the first.
///
/// Each enterprise keeps a snapshot per visit in `GroupEnterpriseVersion`, so
/// "did this business grow between visits" is a query rather than an
/// archaeology exercise. Keeping only the current row makes that question
/// unanswerable the moment anyone edits it.
///
/// Member-level enterprise profiles remain deliberately unmodelled. Surveying
/// every member feeds no named decision; the group's enterprises carry the
/// reporting value.
model GroupEnterprise {
  id      String @id @default(cuid())
  groupId String

  /// What this business is called, so several are tellable apart in a list.
  /// Required: "Enterprise 2" as a fallback label helps nobody in the field.
  name           String
  enterpriseType String?
  description    String?

  /// Money in CENTS, like every other amount in this schema. Storing shillings
  /// as a float is how a ledger ends up out by a rounding error.
  monthlyRevenueCents Int?
  monthlyCostsCents   Int?

  employsPeople Int?
  startedOn     DateTime?

  // -- Market coverage ------------------------------------------------------
  //
  // How far what they produce actually travels, and to how many buyers. Reach
  // is an ORDERED scale (see `MARKET_REACH_LADDER` in domain/enterprise-market)
  // so a move from selling at the farm gate to selling into the county is
  // measurable as a step up, not just a changed string. That ordering is what
  // makes market coverage usable as an outcome indicator rather than a label.

  /// One of MARKET_REACH_LADDER. Null means not asked yet.
  marketReach             String?
  /// Distinct buyers the group sold to in the reporting month.
  buyerCount              Int?
  /// Channel keys, JSON array. A group commonly uses more than one at once —
  /// farm gate for surplus, a trader for volume — so this is not a single
  /// choice.
  marketChannelsJson      String   @default("[]")
  /// A written offtake agreement, which is the difference between a buyer and
  /// a hope. Null means not asked, and is not the same as false.
  hasFormalBuyerAgreement Boolean?
  /// Months of the year the enterprise actually sells, JSON array of 1-12.
  /// A seasonal business compared month-on-month reads as collapsing.
  salesMonthsJson         String   @default("[]")

  mainChallenge String?
  /// Free text kept ALONGSIDE the structured needs below, not replaced by it.
  /// The taxonomy makes needs countable across a programme; the sentence keeps
  /// what the taxonomy could not hold.
  supportNeeded String?

  /// ACTIVE | DORMANT | CLOSED. A closed enterprise stays on the record —
  /// deleting it would erase the history that explains a fall in group income.
  status String @default("ACTIVE")

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  group        Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  versions     GroupEnterpriseVersion[]
  supportNeeds GroupEnterpriseSupportNeed[]

  @@index([groupId, status])
}

/// What one enterprise looked like at one visit. Append-only.
model GroupEnterpriseVersion {
  id           String  @id @default(cuid())
  enterpriseId String
  groupId      String
  visitId      String?

  name                String?
  enterpriseType      String?
  description         String?
  monthlyRevenueCents Int?
  monthlyCostsCents   Int?
  employsPeople       Int?

  marketReach             String?
  buyerCount              Int?
  marketChannelsJson      String   @default("[]")
  hasFormalBuyerAgreement Boolean?
  salesMonthsJson         String   @default("[]")

  mainChallenge String?
  supportNeeded String?
  status        String?

  recordedAt DateTime @default(now())

  enterprise GroupEnterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@unique([enterpriseId, visitId])
  @@index([groupId, recordedAt])
  @@index([enterpriseId, recordedAt])
}

/// A kind of support a group can need. Configurable, like MentorshipTopic.
///
/// The point of a controlled list is that "twelve groups need cold storage" is
/// a sentence somebody can act on, and "needs cold storage" typed twelve
/// different ways is not. Programmes add their own without a deploy.
model SupportNeedType {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  /// FINANCE | MARKET | SKILLS | INPUTS | INFRASTRUCTURE | GOVERNANCE |
  /// TECHNOLOGY. Grouping keeps a long list navigable and lets a report say
  /// which KIND of help is most asked for.
  category    String
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  needs GroupEnterpriseSupportNeed[]
}

/// One support need a group has named, against one enterprise.
///
/// Snapshots the key, title and category at write time for the same reason
/// VisitMentorshipSession does: a record reading "needs <deleted>" is worthless
/// as history, and forbidding deletion instead leaves a settings screen nobody
/// can tidy.
///
/// Carries `groupId` denormalised so a programme-wide count does not have to
/// walk through enterprises, and so the row survives as evidence of what was
/// asked for even if the enterprise is later restructured.
model GroupEnterpriseSupportNeed {
  id           String @id @default(cuid())
  enterpriseId String
  groupId      String

  typeId               String?
  needKeySnapshot      String
  needTitleSnapshot    String
  needCategorySnapshot String

  /// HIGH | MEDIUM | LOW, as the GROUP ranked it. An agent's ordering of
  /// somebody else's problems is a different measurement.
  priority String  @default("MEDIUM")
  /// OPEN | IN_PROGRESS | MET | DECLINED. MET is what turns a list of requests
  /// into a responsiveness indicator: needs raised versus needs met.
  status   String  @default("OPEN")
  detail   String?

  /// The visits that bracket it, so "how long did this take to answer" is a
  /// query and not a guess.
  raisedAtVisitId String?
  metAtVisitId    String?
  raisedAt        DateTime  @default(now())
  metAt           DateTime?

  updatedAt DateTime @default(now()) @updatedAt

  enterprise GroupEnterprise  @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  type       SupportNeedType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([needKeySnapshot, status])
  @@index([enterpriseId, status])
}

model Member {
  id                  String    @id @default(cuid())
  groupId             String
  fullName            String
  nationalIdHash      String?
  phone               String
  role                String    @default("MEMBER")
  kycStatus           String    @default("PENDING")
  status              String    @default("ACTIVE")
  pinHash             String?
  pinSetAt            DateTime?
  pinUpdatedAt        DateTime?
  currentOtpHash      String?
  currentOtpIssuedAt  DateTime?
  currentOtpExpiresAt DateTime?
  joinedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  group           Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userAccounts    User[]
  membershipLinks UserMembership[]
  attendance      Attendance[]
  ledgerEntries   LedgerEntry[]
  keySubmissions  MeetingKeySubmission[]
  pinDeliveries   MemberPinDelivery[]
  groupPayments   GroupPayment[]
  pollCandidacies PollOption[]
  pollVotes       PollVote[]
  loans           Loan[]
  welfareExpenses WelfareExpense[]
  roleAssignments MemberRoleAssignment[]

  // Every member query filters by group; without this it is a full scan, and
  // #12 removes any cap on how many members a group may have.
  @@index([groupId, status])
}

model Meeting {
  id               String    @id @default(cuid())
  groupId          String
  /// Nullable for backward compatibility; backfilled to the group's cycle.
  cycleId          String?
  title            String
  status           String
  scheduledAt      DateTime
  openedAt         DateTime?
  closedAt         DateTime?
  unlockStatus     String    @default("PENDING")
  gpsCompliant     Boolean   @default(false)
  transactionTotal Int       @default(0)
  minutes          String?

  /// Which official closed the meeting, proved by their own PIN at the moment
  /// of sealing. Nullable because meetings sealed before this was required
  /// have no such proof, and inventing one would be worse than admitting it.
  sealedByMemberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group                    Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cycle                    Cycle?                    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  steps                    MeetingStepRecord[]
  attendance               Attendance[]
  keySubmissions           MeetingKeySubmission[]
  ledgerEntries            LedgerEntry[]
  votes                    Vote[]
  externalLoanApplications ExternalLoanApplication[]
  storeCreditRequests      StoreCreditRequest[]
  groupPayments            GroupPayment[]
  polls                    Poll[]

  @@index([groupId, scheduledAt])
}

model MeetingKeySubmission {
  id                String    @id @default(cuid())
  meetingId         String
  memberId          String
  capturedByUserId  String?
  deviceId          String?
  capturedOfflineAt DateTime?
  credentialType    String    @default("DEFAULT_PIN")
  verifiedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  meeting        Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member         Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  capturedByUser User?   @relation("MeetingKeyCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@unique([meetingId, memberId])
}

model MemberPinDelivery {
  id                String    @id @default(cuid())
  memberId          String
  requestedByUserId String?
  provider          String    @default("AFRICAS_TALKING")
  channel           String    @default("SMS")
  purpose           String    @default("DEFAULT_PIN")
  phone             String
  status            String    @default("QUEUED")
  messagePreview    String
  messageCiphertext String
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([status, createdAt])
}

model SmsBroadcast {
  id                String   @id @default(cuid())
  requestedByUserId String?
  targetType        String
  targetGroupId     String?
  targetMemberId    String?

  /// What raised this send: MANUAL (an admin typed it), SHARE_PURCHASE, or
  /// MEETING_SUMMARY. Automatic sends land in the same table as manual ones so
  /// there is one place to answer "what did we text this group, and did it
  /// arrive" — but an operator still has to be able to tell them apart.
  kind String @default("MANUAL")

  /// The meeting a SHARE_PURCHASE or MEETING_SUMMARY send came out of.
  meetingId String?

  provider          String

  /// The body every recipient got, for a send where that is one message.
  /// A per-member summary overrides it on the recipient row.
  message           String
  status            String   @default("QUEUED")
  recipientCount    Int      @default(0)
  queuedCount       Int      @default(0)
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipients SmsBroadcastRecipient[]

  @@index([createdAt])
  @@index([targetType, createdAt])
  @@index([targetGroupId, createdAt])
  @@index([targetMemberId, createdAt])
  @@index([kind, createdAt])
  @@index([meetingId])
}

model SmsBroadcastRecipient {
  id                String    @id @default(cuid())
  broadcastId       String
  memberId          String?
  groupId           String?
  memberName        String
  phone             String

  /// This recipient's own message, when it differs per person — a meeting
  /// summary tells each member what THEY transacted. Null means "the
  /// broadcast's shared message", which is every manual send.
  message           String?

  provider          String
  status            String    @default("QUEUED")
  providerReference String?
  providerStatus    String?
  providerMessage   String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  broadcast SmsBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([memberId, createdAt])
  @@index([groupId, createdAt])
  @@index([status, createdAt])
}

model MeetingStepRecord {
  id          String    @id @default(cuid())
  meetingId   String
  step        String
  name        String
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, step])
}

model Attendance {
  id         String   @id @default(cuid())
  meetingId  String
  memberId   String
  status     String
  recordedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
}

/// One saving cycle of a group: its meetings, its ledger, its share-out.
///
/// `Group.cycleNumber` already existed as a bare integer, which was enough to
/// label a cycle but not to scope anything to it — so closed cycles could still
/// be written to. Rows now point at a Cycle, and a CLOSED cycle refuses writes
/// while remaining fully readable in history and reports.
///
/// cycleId is NULLABLE everywhere it appears. Existing rows and older mobile
/// clients that know nothing about cycles keep working; the backfill fills them
/// in. Making it required would have been a breaking change to a live system.
model Cycle {
  id             String    @id @default(cuid())
  groupId        String
  number         Int
  startedAt      DateTime  @default(now())
  closedAt       DateTime?
  /// ACTIVE | CLOSED. Exactly one ACTIVE cycle per group is expected, but it is
  /// not a DB constraint - SQLite cannot express a partial unique index here,
  /// so openCycleFor() enforces it transactionally instead.
  status         String    @default("ACTIVE")
  /// Set when the cycle is closed by a share-out, so the payout that ended a
  /// cycle is traceable from the cycle itself.
  closedByUserId String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group           Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meetings        Meeting[]
  ledgerEntries   LedgerEntry[]
  loans           Loan[]
  welfareExpenses WelfareExpense[]
  roleAssignments MemberRoleAssignment[]

  @@unique([groupId, number])
  @@index([groupId, status])
}

/// An internal VSLA loan.
///
/// A RECONCILABLE PROJECTION over the ledger, not a second accounting record.
/// `LedgerEntry` remains the source of truth: if the two ever disagree, the
/// ledger wins and this table is rebuilt from it. That is why nothing here
/// stores a balance.
///
/// outstanding = principal + accruedInterest - sum(repayments)
/// accruedInterest = principal * interestRateBps/10000 * elapsedMonths
///   (FLAT monthly on the ORIGINAL principal - it does not reduce as the
///    member repays. Decided 30 Jul 2026.)
///
/// Both are computed on read in loan-service.ts. Storing either would create a
/// number that can silently drift away from the ledger.
model Loan {
  id                  String   @id @default(cuid())
  groupId             String
  memberId            String
  cycleId             String?
  principalCents      Int
  /// Basis points. 0 is legitimate: plenty of groups lend interest-free.
  interestRateBps     Int      @default(0)
  termMonths          Int      @default(1)
  disbursedAt         DateTime
  dueAt               DateTime
  /// ACTIVE | REPAID | CARRIED_FORWARD | WRITTEN_OFF
  status              String   @default("ACTIVE")
  /// Set when a loan is carried into the next cycle at share-out, so the chain
  /// across cycles stays traceable.
  carriedFromLoanId   String?
  /// The ledger row that created this loan. UNIQUE, which is what makes the
  /// backfill idempotent - a second run cannot duplicate a loan.
  disbursementEntryId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  group      Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cycle      Cycle?        @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  repayments LedgerEntry[] @relation("LoanRepayments")

  @@index([groupId, status])
  @@index([memberId])
  @@index([cycleId])
}

/// A welfare payment out of the group's social fund.
///
/// The AMOUNT lives in the ledger, not here — this is the context a ledger
/// line cannot hold: what it was for, who received it, who approved it. Same
/// relationship `Loan` has to the ledger. If the two ever disagree, the ledger
/// wins.
///
/// Consequence for share-out: the welfare fund is spent DOWN during a cycle,
/// and what remains at the end is what gets distributed. Share-out must read
/// the fund's closing balance, never gross contributions.
model WelfareExpense {
  id               String   @id @default(cuid())
  groupId          String
  cycleId          String?
  meetingId        String?
  /// The ledger row that moved the money. UNIQUE, so an expense can never be
  /// double-recorded against the same entry.
  ledgerEntryId    String   @unique
  /// MEDICAL | BEREAVEMENT | EDUCATION | EMERGENCY | OTHER — free text rather
  /// than an enum: constitutions differ and a group must not be blocked from
  /// recording a real payment because its category was not foreseen.
  category         String
  /// Who received it. A member where applicable, otherwise a written name —
  /// welfare is often paid to a member's family or a hospital.
  payeeMemberId    String?
  payeeName        String?
  note             String?
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cycle       Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  payeeMember Member?     @relation(fields: [payeeMemberId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([cycleId])
}

/// Per-group governance settings.
///
/// Deliberately SMALL. The original design had six fields; the 30 Jul
/// decisions removed four of them:
///
///   - shareOutRequiresContributions/Welfare/Fines are gone. Fines and welfare
///     NET OFF a member's payout rather than barring them from share-out, so
///     there is no eligibility gate left to configure.
///   - outstandingLoanHandling is gone. Loans always net off at share-out and
///     are never carried forward, so the only value it could hold was DEDUCT.
///
/// Adding a knob nobody can turn is worse than no knob: it implies a choice
/// exists. What remains is genuinely per-group.
///
/// Every column has a default reproducing today's behaviour, and the row is
/// optional — a group without one behaves exactly as before.
model GroupPolicy {
  groupId String @id

  /// #5. VSLA loans are typically one month. A group whose constitution says
  /// otherwise sets its own; individual loans may still override this.
  defaultLoanTermMonths Int @default(1)

  /// #6. Which fund an expense is drawn from. SOCIAL is the welfare fund and
  /// the near-universal answer, but constitutions differ.
  expenseFundType String @default("SOCIAL")

  /// Basis points charged per month, FLAT on the original principal.
  ///
  /// Defaults to 0 deliberately. A group that has not set its rate lends
  /// interest-free, which understates nothing and invents no debt; guessing a
  /// typical VSLA rate here would silently charge members money their
  /// constitution never agreed to. 1000 = 10% a month, the common VSLA figure.
  loanInterestRateBps Int @default(0)

  /// Text a member when their share purchase is recorded at a meeting.
  ///
  /// Off by default, and deliberately. Every message costs the platform's SMS
  /// credits, a 30-member group buying shares at a monthly meeting is 30 texts
  /// a month per group, and a member's holding is their own financial
  /// information going to a handset that is often shared. A group opts in.
  smsSharePurchaseEnabled Boolean @default(false)

  /// Text every member their own transactions once the meeting is sealed.
  /// Off by default for the same reasons.
  smsMeetingSummaryEnabled Boolean @default(false)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

/// Who held which office, and when.
///
/// `Member.role` says who holds an office NOW. It cannot answer "who was
/// secretary when this meeting was minuted?" — reassigning simply overwrote it,
/// so a change quietly rewrote the past. This table keeps the history: an
/// assignment is ENDED, never edited, and a new row opens.
///
/// Cycle-stamped, so a new cycle can reshuffle leadership (#11) without
/// touching the closed cycle's record of who was responsible.
model MemberRoleAssignment {
  id               String    @id @default(cuid())
  groupId          String
  memberId         String
  cycleId          String?
  /// MEMBER | CHAIRPERSON | SECRETARY | TREASURER | MONEY_COUNTER |
  /// KEY_HOLDER | VILLAGE_AGENT
  role             String
  startedAt        DateTime  @default(now())
  /// Null while held. Set when the office passes to someone else.
  endedAt          DateTime?
  assignedByUserId String?
  note             String?
  createdAt        DateTime  @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cycle  Cycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([groupId, role, endedAt])
  @@index([memberId])
}

