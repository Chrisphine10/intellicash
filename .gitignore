# Every local SQLite file: test and QA databases, CI's migration check, and any
# copy of a real database brought down for a rehearsal (members' personal
# data - never for git).
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
*.sqlite
*.sqlite3
apps/api/uploads/
# The API resolves its upload folder from the working directory, so a run started
# from the repo root writes here instead - visit photos and avatars, never for git.
/uploads/

# Android
apps/android/.gradle/
apps/android/app/build/
apps/android/build/
apps/android/local.properties
*.apk
*.aab
.archive-free-dashboard-template/

# Throwaway databases created by `prisma migrate diff --shadow-database-url`.
# They are rebuilt on demand and have twice now turned up in `git status`
# alongside real work.
shadow-*.db
apps/api/shadow-*.db

# Python bytecode from the scripts in this folder.
__pycache__/
*.pyc
apps/api/prisma/qa.db
apps/api/prisma/qa.db-journal
qa/results.json
qa/world.json
